# ==============================================================================
# HUE SOLUTIONS CANDIDATE ASSESSMENT - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, enter these variables under Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. SUPABASE PUBLIC CONFIGURATION (Exposed to browser / client components)
# ------------------------------------------------------------------------------
# Where to obtain: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Where to obtain: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. SUPABASE PRIVILEGED SERVICE ROLE KEY (STRICTLY SERVER-SIDE - NEVER COMMIT)
# ------------------------------------------------------------------------------
# Where to obtain: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
# IMPORTANT: This key bypasses RLS and must NEVER be prefixed with NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. ADMINISTRATOR ALLOWLIST CONFIGURATION
# ------------------------------------------------------------------------------
# Must match the email address of the manually provisioned administrator in Supabase Auth.
# Only this email address will be authorized to access /admin and mutate projects.
ADMIN_EMAIL=connect.haneen@gmail.com

# ------------------------------------------------------------------------------
# 4. RESEND EMAIL API CONFIGURATION (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Where to obtain: Resend Dashboard (https://resend.com/api-keys) -> Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Sender Email configured in Resend.
# Free development tier default: onboarding@resend.dev
# Production custom domain: notifications@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev
